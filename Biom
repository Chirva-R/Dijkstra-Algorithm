#include <bits/stdc++.h>
using namespace std;

ifstream fin("biom.in");
ofstream fout("biom.out");

const int NMAX = 1e6;
int n;
int A, B, C, D;
string s;
vector<pair<int, int>> v[NMAX + 1]; // Liste de adiacenta: v[nod] = {destinatie, cost}
long long dist[NMAX + 1];           // dist[i] = costul minim de la cubul 0 la cubul i
int poz[NMAX + 1];                  // Vector auxiliar pentru a retine ultima aparitie a unui biom

/**
 * Problema cere costul minim intr-un graf ponderat.
 * Pentru fiecare cub i, avem 4 muchii posibile:
 * 1. i -> i + 1 (cost A) - Pas la dreapta
 * 2. i -> i - 1 (cost B) - Pas la stanga
 * 3. i -> j (minim j > i unde S[i] == S[j], cost C) - Salt la prima aparitie viitoare
 * 4. i -> j (maxim j < i unde S[i] == S[j], cost D) - Salt la ultima aparitie anterioara
 **/

struct State
{
    int nod;
    long long cost;

    // Operator pentru priority_queue (min-heap)
    // Returneaza true daca 'cost' este mai mare, asigurand extragerea elementului minim
    bool operator<(const State& a) const
    {
        return cost > a.cost;
    }
};

void dijkstra(int nod_start)
{
    // Initializam toate distantele cu infinit
    for(int i = 0; i < n; i++)
        dist[i] = LLONG_MAX;
    
    dist[nod_start] = 0;
    priority_queue<State> pq;
    pq.push({nod_start, 0});

    while(!pq.empty())
    {
        int nod_curr = pq.top().nod;
        long long cost_curr = pq.top().cost;
        pq.pop();

        // Daca am gasit deja un drum mai scurt catre acest nod, ignoram starea curenta
        if(cost_curr > dist[nod_curr])
            continue;

        // Relaxam toate muchiile care pleaca din nodul curent
        for(auto i : v[nod_curr])
        {
            int nod_urm = i.first;
            int cost_muchie = i.second;

            if(dist[nod_curr] + cost_muchie < dist[nod_urm])
            {
                dist[nod_urm] = dist[nod_curr] + cost_muchie;
                pq.push({nod_urm, dist[nod_urm]});
            }
        }
    }
}

int main()
{
    // Citirea datelor de intrare
    fin >> n >> A >> B >> C >> D;
    fin >> s;

    // Resetam vectorul de pozitii pentru a procesa salturile 
    fill(poz, poz + 256, -1); // 256 pentru a acoperi caracterele ASCII (biomurile)
    
    for(int i = 0; i < n; i++)
    {
        // 4. i -> j (maxim j < i unde S[i] == S[j]) cu cost D
        if(poz[s[i]] != -1)
        {
            v[i].push_back({poz[s[i]], D});
        }
        poz[s[i]] = i; // Actualizam ultima pozitie vazuta pentru acest biom

        // 1. i -> i + 1 cu cost A
        if(i + 1 < n)
            v[i].push_back({i + 1, A});
            
        // 2. i -> i - 1 cu cost B
        if(i - 1 >= 0)
            v[i].push_back({i - 1, B});
    }

    // Resetam vectorul de pozitii pentru a procesa salturile 
    fill(poz, poz + 256, -1);
    
    for(int i = n - 1; i >= 0; i--)
    {
        // 3. i -> j (minim j > i unde S[i] == S[j]) cu cost C
        // Parcurgem invers pentru a gasi cel mai apropiat cub din dreapta cu acelasi biom
        if(poz[s[i]] != -1)
        {
            v[i].push_back({poz[s[i]], C});
        }
        poz[s[i]] = i;
    }

    // Calculam costul minim de la prima pozitie (0)
    dijkstra(0);

    // Rezultatul este distanta minima pana la ultima pozitie (n-1)
    fout << dist[n - 1];

    return 0;
}
